                "ignoreCase": false
              }
            ]
          }
        ],
        "devSolutionCode": "pet_name = \"Ada\"\npet_type = \"PyPet\"\npet_age = 0",
        "isReplEnabled": true
      },
      {
        "id": 2,
        "title": "Review",
        "steps": [
          {
            "type": "dialogue",
            "messages": [
              "Notice how we didn't need to use quotation marks around `pet_name` because that's a **variable**.",
              "If you want your PyPet to say \"Hello world\" you need to put that in quotation marks because that's raw text (what programmers call a **string**), it's different from a **variable** box.",
              "Use the print statement again to get your PyPet to say its type. (Remember we saved this as a **variable** - you can still see it in your locked code if you need a reminder!)"
            ],
            "blockFinalMessage": true
          },
          {
            "type": "action",
            "actionType": "repl_test",
            "replChecks": [
              {
                "type": "matchOutput",
                "accept": [
                  "PyPet",
                  "'PyPet'",
                  "\"PyPet\""
                ],
                "ignoreCase": false
              }
            ]
          }
        ],
        "isReplEnabled": true
      }
    ]
